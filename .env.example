TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
# optional: user OAuth token, removes ads/raises quality for streamlink
TWITCH_USER_OAUTH=
# STREAMERS ist die EINZIGE Liste der ueberwachten Creator (leer = Pipeline startet nicht).
# Format je Eintrag: [plattform:]login[:sprache[:erlaubnis]], durch Komma getrennt
#   plattform: twitch (Standard) | kick      sprache: de | en (Standard en)
#   erlaubnis: none (Standard) | asked | public_ok | campaign
# Sprache bestimmt Hook, Untertitel, Titel, Caption und Hashtags der Clips.
# Aenderungen greifen beim naechsten Live-Check (ca. 1 min), ohne Neustart. Pruefen: uv run vc streamers
# Beispiel: STREAMERS=twitch:beispiel_login:de, kick:anderer_login:en:campaign
# Beispiel: STREAMERS=streamer_eins:de, twitch:streamer_zwei:en:asked
STREAMERS=
